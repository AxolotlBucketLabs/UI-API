# Static analysis against Axolotl-PM (the default dev dependency).
# phpstan.pocketmine.neon runs the same analysis against upstream PocketMine-MP.
includes:
	- vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
	level: 10
	phpVersion:
		min: 80100
		max: 80499
	paths:
		- src
		- tests
	excludePaths:
		analyse:
			# Written against upstream PocketMine-MP's protocol; analysed by phpstan.pocketmine.neon.
			- src/ninjaknights/ui/sidebar/protocol/PocketMineScoreboardPackets.php
			- src/ninjaknights/ui/bossbar/protocol/PocketMineBossBarPackets.php
	tmpDir: .phpstan-cache
	treatPhpDocTypesAsCertain: false
	checkMissingCallableSignature: true
	checkUninitializedProperties: true
	reportUnmatchedIgnoredErrors: true
