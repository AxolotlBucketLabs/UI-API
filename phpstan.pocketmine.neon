# Static analysis against upstream PocketMine-MP 5. Install it in place of Axolotl-PM
# first (see "Development" in README.md), then run: vendor/bin/phpstan -c phpstan.pocketmine.neon
includes:
	- vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
	level: 10
	phpVersion:
		min: 80100
		max: 80499
	paths:
		- src
		- tests
	excludePaths:
		analyse:
			# Written against Axolotl-PM's protocol; analysed by phpstan.neon.dist.
			- src/ninjaknights/ui/sidebar/protocol/AxolotlScoreboardPackets.php
			- src/ninjaknights/ui/bossbar/protocol/AxolotlBossBarPackets.php
	tmpDir: .phpstan-cache/pocketmine
	treatPhpDocTypesAsCertain: false
	checkMissingCallableSignature: true
	checkUninitializedProperties: true
	reportUnmatchedIgnoredErrors: true
