{
	"name": "axolotlbucketlabs/ui-api",
	"description": "Virion and Composer library for forms, shared sidebars and boss bars in Axolotl-PM plugins",
	"type": "library",
	"license": "GPL-3.0-only",
	"keywords": ["axolotl-pm", "virion", "bedrock", "forms", "scoreboard", "sidebar", "bossbar"],
	"homepage": "https://github.com/AxolotlBucketLabs/UI-API",
	"authors": [
		{
			"name": "AxolotlBucketLabs"
		},
		{
			"name": "NinjaKnights"
		}
	],
	"require": {
		"php": "^8.4"
	},
	"require-dev": {
		"axolotl-pm/pocketmine-mp": "5.51.0",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-strict-rules": "^2.0",
		"phpunit/phpunit": "^10.5"
	},
	"autoload": {
		"psr-4": {
			"AxolotlBucketLabs\\UI\\": "src/AxolotlBucketLabs/UI/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"AxolotlBucketLabs\\UI\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"analyse": "@php vendor/phpstan/phpstan/phpstan analyse --memory-limit=1G",
		"test": "@php vendor/phpunit/phpunit/phpunit",
		"check": [
			"@analyse",
			"@test"
		]
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {}
	}
}
